{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilteringComment",
  "description": "필터링 평가용 댓글 한 건. data/*.jsonl의 한 줄이 이 계약을 따른다. 기준은 docs/rubric.md.",
  "type": "object",
  "required": [
    "id",
    "text",
    "expectedAction",
    "categories",
    "source",
    "reviewStatus"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "데이터 안에서 고유한 ID"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "댓글 본문. Cking-BE 댓글 제한과 같다(1~500자)."
    },
    "expectedAction": {
      "type": "string",
      "enum": [
        "PASS",
        "HOLD",
        "BLOCK"
      ],
      "description": "사람이 정한 정답 처리 결과"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NONE",
          "ABUSE",
          "HATE",
          "SPAM",
          "PRIVACY"
        ]
      },
      "description": "위반 유형. 위반이 없으면 [\"NONE\"]이며 NONE은 다른 유형과 함께 쓰지 않는다."
    },
    "borderline": {
      "type": "boolean",
      "default": false,
      "description": "경계 사례(라벨러 간 판단이 갈리거나 인용·변형 표기 등)"
    },
    "source": {
      "type": "string",
      "description": "synthetic(직접 작성) 또는 출처 설명. docs/data-policy.md 참고"
    },
    "platform": {
      "type": "string",
      "enum": ["instagram", "youtube", "facebook"],
      "description": "댓글 말투와 게시 맥락을 참고한 플랫폼. synthetic 데이터의 실제 수집 출처를 뜻하지 않는다."
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "pending_human",
        "approved"
      ],
      "description": "approved만 지표에 사용한다."
    },
    "notes": {
      "type": "string",
      "description": "라벨 판단 근거. PRIVACY 샘플은 가짜 값임을 적는다."
    },
    "split": {
      "type": "string",
      "enum": [
        "dev",
        "final"
      ],
      "description": "개발용(dev)은 방법을 고칠 때 보는 데이터, 최종 평가용(final)은 방법을 확정한 뒤 한 번만 보는 데이터다. 없으면 dev로 본다. 같은 pairId는 같은 split에 둔다."
    },
    "caseType": {
      "type": "string",
      "enum": [
        "quote",
        "idiom",
        "friendly",
        "sarcasm",
        "threat",
        "weak_hate",
        "directed_negative",
        "polite_complaint"
      ],
      "description": "문맥 판별 유형(docs/rubric.md의 문맥 판별 유형 참고)"
    },
    "pairId": {
      "type": "string",
      "description": "단어를 거의 같게 두고 문맥만 달라지는 정상·위반 짝을 묶는 ID. 짝은 정확히 두 건이다."
    },
    "contextNeeded": {
      "type": "boolean",
      "default": false,
      "description": "댓글 한 건만으로 판단할 수 없고 context가 있어야 판단되는 경우 true"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postText": {
          "type": "string",
          "description": "댓글이 달린 게시글 내용 요약"
        },
        "previousComment": {
          "type": "string",
          "description": "바로 앞선 댓글"
        },
        "authorRole": {
          "type": "string",
          "enum": [
            "fan",
            "creator"
          ],
          "description": "댓글 작성자 구분"
        }
      },
      "description": "contextNeeded가 true일 때 넣는다. BE가 실제로 넘길 수 있는 정보와 맞춰 확정한다."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "categories": {
            "contains": {
              "const": "NONE"
            }
          }
        },
        "required": [
          "categories"
        ]
      },
      "then": {
        "properties": {
          "categories": {
            "maxItems": 1
          }
        }
      }
    }
  ]
}
