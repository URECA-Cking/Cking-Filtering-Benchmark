{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilteringComment",
  "description": "필터링 평가용 댓글 한 건. data/*.jsonl의 한 줄이 이 계약을 따른다. 기준은 docs/rubric.md.",
  "type": "object",
  "required": ["id", "text", "expectedAction", "categories", "source", "reviewStatus"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "데이터 안에서 고유한 ID"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "댓글 본문. Cking-BE 댓글 제한과 같다(1~500자)."
    },
    "expectedAction": {
      "type": "string",
      "enum": ["PASS", "HOLD", "BLOCK"],
      "description": "사람이 정한 정답 처리 결과"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["NONE", "ABUSE", "HATE", "SPAM", "PRIVACY"] },
      "description": "위반 유형. 위반이 없으면 [\"NONE\"]이며 NONE은 다른 유형과 함께 쓰지 않는다."
    },
    "borderline": {
      "type": "boolean",
      "default": false,
      "description": "경계 사례(라벨러 간 판단이 갈리거나 인용·변형 표기 등)"
    },
    "source": {
      "type": "string",
      "description": "synthetic(직접 작성) 또는 출처 설명. docs/data-policy.md 참고"
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["pending_human", "approved"],
      "description": "approved만 지표에 사용한다."
    },
    "notes": {
      "type": "string",
      "description": "라벨 판단 근거. PRIVACY 샘플은 가짜 값임을 적는다."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "categories": { "contains": { "const": "NONE" } } }, "required": ["categories"] },
      "then": { "properties": { "categories": { "maxItems": 1 } } }
    }
  ]
}
